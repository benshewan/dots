+/// The first image of an MCP result, with how many the result carried.
+///
+/// The media type is best effort: maki relabels an image whose bytes disagree
+/// with it, so an unknown mime still reaches the model instead of being
+/// dropped. A tool result carries one image here, exactly as `view_image` does.
+fn mcp_image(images: &[(String, String)]) -> Option<(ImageSource, usize)> {
+    let (mime_type, data) = images.first()?;
+    let media_type = ImageMediaType::from_mime(mime_type).unwrap_or(ImageMediaType::Png);
+    Some((
+        ImageSource::new(media_type, Arc::from(data.as_str())),
+        images.len(),
+    ))
+}
