{config, ...}: let
  username = config.flake.meta.user.username;
in {
  flake.modules.homeManager."programs/distrobox" = {
    programs.distrobox.enable = true;
  };

  # Preservation companion for "programs/distrobox" (auto-resolved by the
  # prefix). Intentionally EMPTY, audited live with a docker backend:
  # - distrobox containers mount the user's real HOME, so files created
  #   inside land in normal home dirs — nothing extra to preserve.
  # - The container rootfs lives in the BACKEND's storage, not home:
  #   /var/lib/docker for docker, ~/.local/share/containers for podman
  #   rootless (that would belong to a podman module's companion).
  # - The per-container launcher (distrobox writes
  #   ~/.local/share/applications/<name>.desktop +
  #   ~/.local/share/icons/distrobox/) is regenerated by
  #   distrobox-generate-entry / on create — regenerable, left volatile.
  # - ~/.config/distrobox only exists when HM settings/containers are
  #   declared (HM generates it — skip, btop rule).
  flake.modules.nixos."preservation/programs/distrobox" = {config, ...}: {
    preservation.preserveAt.${config.modules.preservation.persistentPath}.users.${username} = {};
  };
}
