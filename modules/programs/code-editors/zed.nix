{config, ...}: let
  flakePath = config.flake.meta.flake-path;
  # Flake-level user metadata; config.flake does not exist inside NixOS
  # modules, which shadow `config` with the host config.
  username = config.flake.meta.user.username;
in {
  flake.modules.homeManager."programs/zed" = {
    pkgs,
    lib,
    ...
  }: {
    programs.zed-editor = {
      enable = true;
      extensions = [
        # Languages
        "git-firefly" # git syntax support
        "nix" # nix LSP support
        "ini" # ini/config language support
        "angular" # Angular support
        "lua" # Lua support
        "xml" # XML support
        "csharp" # C# support
        # Comfort
        "comment" # Hightlight special comments eg. TODO
        "codebook" # Spell checker
        "rainbow-csv" # make CSVs readable
        "colored-zed-icons-theme" # pretty icons
      ];
      userSettings = {
        # Telemetry
        telemetry = {
          diagnostics = false;
          metrics = false;
        };

        # Workspace
        session = {
          trust_all_worktrees = true;
        };

        # General
        always_treat_brackets_as_autoclosed = true;
        focus_follows_mouse = {
          enabled = true;
          debounce_ms = 0;
        };
        extend_comment_on_newline = false;
        autosave = "on_focus_change";

        # Colab
        collaboration_panel.button = false;

        # Panels
        project_panel.dock = "left";
        git_panel.dock = "left";
        # No "enabled" key exists; hiding the status-bar toggle is the removal lever
        outline_panel.button = false;

        # Apperance
        buffer_font_size = lib.mkForce 14.0; # Override stylix font size
        title_bar.show_sign_in = false;
        icon_theme = "Colored Zed Icons Theme Dark";
        colorize_brackets = true;
        indent_guides.coloring = "indent_aware";
        toolbar = {
          breadcrumbs = false;
          quick_actions = false;
        };

        # Nix language support
        lsp.nixd = {
          binary.path = lib.getExe pkgs.nixd;
          settings = {
            nixd = {
              nixpkgs.expr = "import (builtins.getFlake \"${flakePath}\").inputs.nixpkgs { }";
              formatting.command = [(lib.getExe pkgs.alejandra)];
              options = {
                nixos.expr = "let fl = builtins.getFlake \"${flakePath}\"; in fl.nixosConfigurations.caelum.options // fl.nixosConfigurations.navis.options";
                home-manager.expr = "let fl = builtins.getFlake \"${flakePath}\"; in fl.nixosConfigurations.caelum.options.home-manager.users.type.getSubOptions [] // fl.nixosConfigurations.navis.options.home-manager.users.type.getSubOptions []";
              };
            };
          };
        };
        languages = {
          Nix = {
            language_servers = ["nixd" "!nil"];
            format_on_save = "on";
            formatter.external = {
              command = lib.getExe pkgs.alejandra;
              arguments = ["--quiet" "--"];
            };
          };
        };

        # JavaScript Support
        languages.JavaScript = {
          formatter.external = {
            "command" = lib.getExe pkgs.biome;
            "arguments" = ["format" "--stdin-file-path" "{buffer_path}"];
          };
          code_actions_on_format = {
            "source.fixAll.eslint" = true;
          };
        };

        # CSV Support
        languages.CSV = {
          soft_wrap = "none";
        };
        # AI: off entirely (agent panel, edit predictions, inline assist)
        disable_ai = true;
        # disable_ai alone leaves the terminal Inline Assist button on some builds
        agent = {
          enabled = false;
          button = false;
        };

        auto_update = false;
      };
    };
  };

  # Preservation companion for "programs/zed" (auto-resolved by the prefix).
  flake.modules.nixos."preservation/programs/zed" = {config, ...}: {
    preservation.preserveAt.${config.modules.preservation.persistentPath}.users.${username}.directories = [
      # Conversations and UI-installed extensions; settings.json/keymaps
      # are regenerated by Home Manager but written back by Zed's UI.
      ".config/zed"
      ".local/share/zed"
    ];
  };
}
